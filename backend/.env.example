DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eve_care?schema=public"
# every secret must be long and random, e.g. `openssl rand -hex 32`. the server won't start if one is missing
ACCESS_TOKEN_SECRET=super-long-access-secret
HOSPITAL_TOKEN_SECRET=super-long-hospital-secret-must-differ-from-access
REFRESH_TOKEN_SECRET=super-long-refresh-secret
HOSPITAL_REFRESH_TOKEN_SECRET=super-long-hospital-refresh-secret-must-differ-from-refresh
# cookie names for the refresh tokens, must be different
USER_REFRESH_COOKIE=refreshToken
REFRESH_COOKIE=hospitalRefreshToken
WEBHOOK_SECRET=super-long-webhook-secret-shared-with-the-payment-provider
