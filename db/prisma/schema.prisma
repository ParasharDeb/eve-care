generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status{
  Pending
  Confirmed
  Failed
  Cancelled
}
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String
  password      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  refreshtoken  String   @default(" ")
  tests         Booking[]
}
model Hospital{
  id          String     @id @default(uuid())
  email       String     @unique
  hopitalname String     @unique
  password    String
  location    String
  refrestoken String
  Tests       Test[]
}
model Test{
  id          String     @id @default(uuid())
  name        String
  price       Int
  hospitalId  String
  hospital    Hospital  @relation(fields: [hospitalId],references: [id])  
  user        Booking[]   
}
model Booking {
  id        String   @id @default(uuid())
  userId    String
  testId    String
  status    Status   @default(Pending)
  paymentStatus Status
  date      DateTime
  time      DateTime
  user      User     @relation(fields: [userId], references: [id])
  test      Test     @relation(fields: [testId], references: [id])
  createdAt DateTime @default(now())
}