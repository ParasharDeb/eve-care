generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String
  password      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  refreshtoken  String   @default(" ")
}
