generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  username      String
  password      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  refreshtoken  String   @default(" ")
}
model Hospital{
  id          String     @id @default(uuid())
  email       String     @unique
  hopitalname String     @unique
  password    String
  location    String
  refrestoken String
  Tests       Test[]
}
model Test{
  id          String     @id @default(uuid())
  name        String
  price       Int
  hospitalId  String
  hospital    Hospital  @relation(fields: [hospitalId],references: [id])     
}
